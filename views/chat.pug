doctype html
html(lang="bg")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Чат система | #{user.username}
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css")
    link(rel="shortcut icon", href="https://img.icons8.com/?size=100&id=lMGOquc93TO2&format=png&color=000000", type="image/x-icon")
    link(rel="stylesheet", href="/styles/chat.css")
  
  body
    #userData(data-user=JSON.stringify(user))
    .app-container
      .sidebar
        .sidebar-header
          .user-profile
            .user-avatar= user.username.charAt(0).toUpperCase()
            .user-name= user.username
          button.logout-btn#logoutBtn(title="Изход")
            i.fas.fa-sign-out-alt
        
        .search-container
          input.search-input(type="text" placeholder="Търсене на потребители...")
        
        .users-list#usersList
          if allUsers && allUsers.length
            each userItem in allUsers
              if userItem._id.toString() !== user._id.toString()
                .user-item(data-user-id=userItem._id)
                  .user-status(class=userItem.online ? 'online' : 'offline')
                  .user-info
                    .user-name= userItem.username
                    .user-status-text= userItem.online ? 'онлайн' : 'офлайн'
          else
            .no-users Списъкът с потребители е празен
      
      .chat-container
        .chat-header
          .chat-title Групов чат
          .chat-status
            span.status-indicator
            span Онлайн
        
        .chat-tabs#chatTabs
          .chat-tab.active(data-tab="group")
            | Групов чат
            span.chat-tab-close
              i.fas.fa-times
        
        .chat-content
          .chat-box
            .message-container
              ul.message-list#groupMessages
                each message in messages
                  if message.user
                    li.message(class=message.user._id.toString() === user._id.toString() ? 'my-message' : 'other-message')
                      .message-header
                        .message-username= message.user.username
                        .message-time= new Date(message.timestamp).toLocaleTimeString()
                      .message-content= message.text
                  else
                    li.message(class='other-message')  
                      .message-header
                        .message-username= 'Unknown User'  
                        .message-time= new Date(message.timestamp).toLocaleTimeString()
                      .message-content= message.text
        
          .input-area
            .message-form
              form#messageForm
                .form-group
                  input#messageInput(type="text" placeholder="Напишете съобщение..." autocomplete="off")
                  button.send-btn(type="submit")
                    i.fas.fa-paper-plane
                    span Изпрати

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.socket.io/4.0.1/socket.io.min.js")
    script(src="/js/chat.js")
