doctype html
html(lang="bg")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Вход в системата | Chat me app
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css")
    link(rel="shortcut icon", href="https://img.icons8.com/?size=100&id=lMGOquc93TO2&format=png&color=000000", type="image/x-icon")
    link(rel="stylesheet", href="/styles/login.css")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    
  body.animate__animated.animate__fadeIn
    .login-container
      .login-card.animate__animated.animate__fadeInUp
        if messages && messages.error
          each msg in messages.error
            .alert.alert-danger.alert-dismissible.fade.show(role="alert")
              | #{msg}
              button.close(type="button" data-dismiss="alert" aria-label="Close")
                span(aria-hidden="true") &times;
        
        .login-header
          h1 Добре дошли!
          p Моля, въведете вашите данни за вход
        
        form.login-form(method='POST' action='/login')
          .form-group.float-label
            input#email.form-control(type='email', name='email', placeholder=' ')
            label(for='email') Имейл адрес
            .error-message Моля, въведете валиден имейл адрес
          
          .form-group.float-label
            input#password.form-control(type='password', name='password', placeholder=' ')
            label(for='password') Парола
            .error-message Моля, въведете вашата парола
          
          .remember-me
            input#remember(type='checkbox', name='remember')
            label(for='remember') Запомни ме
          
          button.btn-login(type='submit') Вход
          
          .additional-links
            a(href='/forgot-password') Забравена парола?
            span.mx-2 •
            a(href='/register') Регистрация

  script(src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js")
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js")
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const closeButtons = document.querySelectorAll('.close');
      closeButtons.forEach(button => {
        button.addEventListener('click', function() {
          this.closest('.alert').style.display = 'none';
        });
      });
      
      const form = document.querySelector('.login-form');
      if (form) {
        form.addEventListener('submit', function(e) {
          let isValid = true;
          
          const email = document.getElementById('email');
          const password = document.getElementById('password');
          
          if (!email.value || !email.value.includes('@')) {
            email.parentElement.classList.add('error');
            isValid = false;
          } else {
            email.parentElement.classList.remove('error');
          }
          
          if (!password.value || password.value.length < 6) {
            password.parentElement.classList.add('error');
            isValid = false;
          } else {
            password.parentElement.classList.remove('error');
          }
          
          if (!isValid) {
            e.preventDefault();
          }
        });
      }
      
      
      const floatInputs = document.querySelectorAll('.float-label input');
      floatInputs.forEach(input => {
        input.addEventListener('focus', function() {
          this.nextElementSibling.style.top = '-0.6rem';
          this.nextElementSibling.style.left = '0.8rem';
          this.nextElementSibling.style.fontSize = '0.75rem';
          this.nextElementSibling.style.color = 'var(--primary-color)';
        });
        
        input.addEventListener('blur', function() {
          if (!this.value) {
            this.nextElementSibling.style.top = '0.8rem';
            this.nextElementSibling.style.left = '1rem';
            this.nextElementSibling.style.fontSize = '1rem';
            this.nextElementSibling.style.color = 'var(--text-light)';
          }
        });
      });
    });