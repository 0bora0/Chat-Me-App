extends layout

block content
  .register-container
    .register-card
      if messages && messages.error
        each msg in messages.error
          .alert.alert-danger.alert-dismissible.fade.show(role="alert")
            | #{msg}
            button.close(type="button" data-dismiss="alert" aria-label="Close")
              span(aria-hidden="true") &times;

      .register-header
        h1 Регистрация
        p Създайте своя акаунт, за да продължите
      
      form.register-form(method='POST' action='/register')
        .form-group
          label.form-label(for="username") Потребителско име
          .input-wrapper
            input.form-control(type='text', name='username', id="username", placeholder="Въведете потребителско име", required)
            i.fas.fa-user.input-icon
        
        .form-group
          label.form-label(for="name") Име
          .input-wrapper
            input.form-control(type='text', name='name', id="name", placeholder="Въведете вашето име", required)
            i.fas.fa-id-card.input-icon
        
        .form-group
          label.form-label(for="email") Имейл адрес
          .input-wrapper
            input.form-control(type='email', name='email', id="email", placeholder="Въведете вашия имейл", required)
            i.fas.fa-envelope.input-icon
        
        .form-group
          label.form-label(for="password") Парола
          .input-wrapper
            input.form-control(type='password', name='password', id="password", placeholder="Въведете парола", required)
            i.fas.fa-lock.input-icon
            span.password-toggle#togglePassword
              i.fas.fa-eye
        
        button.btn-register(type='submit')
          i.fas.fa-user-plus
          | Регистрирай се
        
        .form-footer
          p Регистрирайки се, вие се съгласявате с нашите 
            a(href="#") Условия за ползване
            |  и 
            a(href="#") Политика за поверителност
      
      .divider или
      
      .social-login
        .social-btn.google
          i.fab.fa-google
        .social-btn.facebook
          i.fab.fa-facebook-f
        .social-btn.github
          i.fab.fa-github
      
      .login-link
        | Вече имате акаунт? 
        a(href='/login') Влезте оттук

  script(src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js")
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js")
  link(rel="stylesheet", href="/styles/register.css")
  link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
  link(rel="shortcut icon", href="https://img.icons8.com/?size=100&id=lMGOquc93TO2&format=png&color=000000", type="image/x-icon")
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const togglePassword = document.querySelector('#togglePassword');
      const password = document.querySelector('#password');
      
      if (togglePassword && password) {
        togglePassword.addEventListener('click', function() {
          const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
          password.setAttribute('type', type);
          this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
        });
      }
      
      const closeButtons = document.querySelectorAll('.close');
      closeButtons.forEach(button => {
        button.addEventListener('click', function() {
          this.closest('.alert').style.display = 'none';
        });
      });
    });